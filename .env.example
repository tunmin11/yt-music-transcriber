# --- Lyrics (optional) ---
# Any OpenAI-compatible speech-to-text API. Leave empty to disable lyrics.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Binaries (optional, default: found on PATH) ---
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# --- Limits / tuning ---
# Reject videos longer than this (seconds)
MAX_DURATION_SECONDS=900
# Force a TensorFlow.js backend: tensorflow | wasm | cpu (default: best available)
# TF_BACKEND=wasm
